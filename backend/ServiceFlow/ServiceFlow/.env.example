# Copie para .env (ou configure no Railway) — nunca faça commit de valores reais.
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/serviceflow?useSSL=false&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=sua_senha
# Mínimo de 32 caracteres. Gere com: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRATION_MINUTES=60
CORS_ALLOWED_ORIGINS=http://localhost:5500,https://service-flow-n9wv.vercel.app
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
